   VeriTrakk  -  veritrakk.tcss
   Full Upgrade  |  Westbound Designs
   ========================================================= */

/* ── Global ─────────────────────────────────────────────── */
Screen {
    background: #0d0d0d;
}

Header {
    background: #1a1a1a;
    color: lightsalmon;
    text-style: bold;
    height: 1;
}

Footer {
    background: #111;
    color: #444;
    height: 1;
}

/* ── Toolbar ────────────────────────────────────────────── */
#toolbar {
    height: auto;
    padding: 0 1;
    background: #111;
    border-bottom: solid darkseagreen;
    align: left middle;
}

.toolbar_btn {
    margin: 0 1 0 0;
    min-width: 10;
    background: #1e1e1e;
    border: none;
    color: #666;
}

.toolbar_btn:hover {
    background: #2a2a2a;
    color: darkkhaki;
}

.toolbar_btn:focus {
    background: #2a2a2a;
    color: goldenrod;
    border: none;
    text-style: bold;
}

.toolbar_btn.active_mode {
    color: lightsalmon;
    text-style: bold;
    background: #1e1010;
}

#status_bar {
    width: 1fr;
    margin-left: 2;
    color: darkkhaki;
    content-align: right middle;
}

#quest_time {
    margin-left: 2;
    color: cadetblue;
    text-style: bold;
    display: none;
}

#quest_clock_lbl {
    margin-left: 1;
    color: darkkhaki;
    display: none;
}

#quest_clock_switch {
    margin-left: 1;
    width: auto;
    display: none;
}

/* ── Main split ─────────────────────────────────────────── */
#main {
    height: 1fr;
}

/* ── Sidebar ────────────────────────────────────────────── */
#sidebar {
    width: 30%;
    height: 1fr;
    background: #0f0f0f;
    border-right: solid darkseagreen;
}

/* home */
#side_home {
    padding: 2 1 1 1;
    height: 1fr;
    align: center top;
}

#logo {
    color: lightsalmon;
    text-style: bold;
    text-align: center;
    content-align: center top;
    width: 100%;
    padding-bottom: 1;
}

/* run */
#side_run {
    padding: 1;
    height: 1fr;
}

#run_name {
    padding-bottom: 1;
}

#run_progress {
    padding-bottom: 1;
}

#run_step_info {
    color: #888;
    padding-top: 1;
    border-top: solid #252525;
    height: 1fr;
}

/* build */
#side_build {
    height: 1fr;
}

#side_build_title {
    color: darkseagreen;
    padding: 0 1;
    height: auto;
}

#build_file_label {
    height: auto;
    padding: 0 1;
    color: goldenrod;
    border-top: solid #252525;
}

/* ── Content ────────────────────────────────────────────── */
#content {
    width: 1fr;
    height: 1fr;
    background: #0d0d0d;
}

/* home */
#view_home {
    padding: 1 3;
}

Markdown {
    background: transparent;
    color: darkkhaki;
}

MarkdownH1 {
    color: lightsalmon;
    text-style: bold;
    background: transparent;
}

MarkdownH2 {
    color: darkseagreen;
    text-style: bold;
    background: transparent;
}

MarkdownH3 {
    color: cadetblue;
    background: transparent;
}

MarkdownCode {
    color: goldenrod;
    background: transparent;
}

MarkdownFence {
    background: #111;
    color: darkkhaki;
}

/* open hint — removed (now a dialog) */

/* run */
#view_run {
    height: 1fr;
    padding: 0;
}

#process_tree {
    height: 1fr;
    border: none;
    padding: 0 1;
    background: transparent;
}

/* build */
#view_build {
    height: 1fr;
}

#build_toolbar {
    height: auto;
    padding: 0 1;
    background: #111;
    border-bottom: solid darkseagreen;
    align: left middle;
}

#build_name_inp {
    width: 1fr;
    margin: 0 1 0 0;
    background: transparent;
    border-top: none;
    border-left: none;
    border-right: none;
    border-bottom: solid darkseagreen;
    color: lightsalmon;
    padding: 0;
}

#build_name_inp:focus {
    border-bottom: solid goldenrod;
    color: goldenrod;
    background: transparent;
}

.build_btn {
    margin: 0 0 0 1;
    min-width: 8;
}

#builder_tree {
    height: 1fr;
    border: none;
    padding: 0 1;
    background: transparent;
}

/* logs */
#view_logs {
    height: 1fr;
    padding: 1;
}

#log_output {
    height: 1fr;
    color: darkkhaki;
    background: transparent;
}

/* ── Tree cursor / guides ───────────────────────────────── */
Tree > .tree--cursor {
    background: #12201c;
    color: darkseagreen;
}

Tree > .tree--highlight {
    background: transparent;
}

Tree > .tree--highlight-line {
    background: transparent;
}

Tree > .tree--guides {
    color: #2a2a2a;
}

Tree > .tree--guides-hover {
    color: #444;
}

/* ── Modals ─────────────────────────────────────────────── */
NoteScreen,
ThresholdScreen,
StepScreen,
ConfirmScreen,
NewFileTypeScreen {
    align: center middle;
}

#modal_box {
    background: #181818;
    border: double darkseagreen;
    padding: 1 2;
    width: 60;
    height: auto;
    max-height: 90%;
}

#new_file_type_box {
    background: #181818;
    border: double darkseagreen;
    padding: 1 2;
    width: 78;
    height: auto;
    max-height: 90%;
}

#modal_title {
    color: lightsalmon;
    text-style: bold;
    text-align: center;
    width: 100%;
    padding-bottom: 1;
}

#thresh_step_label {
    color: goldenrod;
    padding-bottom: 0;
}

#thresh_bounds {
    color: cadetblue;
    padding-bottom: 1;
}

#confirm_msg {
    color: darkkhaki;
    text-align: center;
    width: 100%;
    padding: 1 0;
}

NoteScreen Label,
StepScreen Label {
    color: darkseagreen;
    height: 1;
    width: 100%;
    padding-top: 1;
}

#modal_box Input {
    background: #111;
    border-top: none;
    border-left: none;
    border-right: none;
    border-bottom: solid darkseagreen;
    color: darkkhaki;
    margin-bottom: 0;
}

#modal_box Input:focus {
    border-bottom: solid goldenrod;
    color: goldenrod;
    background: #111;
}

#modal_btns {
    height: auto;
    align: center middle;
    padding-top: 1;
}

#modal_btns Button {
    margin: 0 1;
}

#new_file_type_box Button:focus {
    text-style: none;
    tint: transparent;
}

/* ── Button variants (themed) ───────────────────────────── */
Button.-success {
    background: #1a3a20;
    color: darkseagreen;
    border-top: tall #2a5a30;
}

Button.-success:hover {
    background: #2a4a30;
    color: lightgreen;
}

Button.-error {
    background: #3a1010;
    color: #cc5555;
    border-top: tall #5a1818;
}

Button.-error:hover {
    background: #4a1818;
    color: #ff7777;
}

Button.-primary {
    background: #10203a;
    color: cadetblue;
    border-top: tall #1a3560;
}

Button.-primary:hover {
    background: #1a3050;
    color: lightblue;
}

Button.-warning {
    background: #3a2a10;
    color: goldenrod;
    border-top: tall #5a4010;
}

Button.-warning:hover {
    background: #4a3818;
    color: #ffd060;
}

Button.-default {
    background: #222;
    color: #888;
    border-top: tall #333;
}

Button.-default:hover {
    background: #2a2a2a;
    color: darkkhaki;
}

/* ── File Picker Dialog ─────────────────────────────────── */
FilePickerScreen {
    align: center middle;
}

#fp_box {
    background: #181818;
    border: double darkseagreen;
    padding: 1 2;
    width: 70;
    height: 80%;
}

#fp_title {
    color: lightsalmon;
    text-style: bold;
    text-align: center;
    width: 100%;
    padding-bottom: 1;
}

#fp_path {
    color: #555;
    height: auto;
    padding-bottom: 1;
}

#fp_tree {
    height: 1fr;
    border: solid #2a2a2a;
    background: #111;
    margin-bottom: 1;
}

FilePickerScreen Label {
    color: darkseagreen;
    height: 1;
    padding-top: 0;
}

#fp_name {
    background: #111;
    border-top: none;
    border-left: none;
    border-right: none;
    border-bottom: solid darkseagreen;
    color: darkkhaki;
    margin-bottom: 1;
}

#fp_name:focus {
    border-bottom: solid goldenrod;
    color: goldenrod;
    background: #111;
}

#fp_btns {
    height: auto;
    align: right middle;
}

